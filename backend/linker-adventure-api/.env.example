# ---------------------------------------------------------------------------
# Linker Adventure API — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Absolute or relative path to the SQLite file (node:sqlite, no native build)
DATABASE_FILE=./storage/linker-adventure.db

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12

# Comma-separated list of origins allowed to call the API
# (5500/5501 are VS Code Live Server's default ports for the static frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://localhost:5501

# Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20