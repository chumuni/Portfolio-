{
  "name": "linker-adventure-api",
  "version": "1.0.0",
  "description": "Linker Adventure — B2B tourism matchmaking API connecting tour companies with tour agents",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "db:migrate": "node --no-warnings src/db/migrate.js",
    "db:seed": "node --no-warnings src/db/seed.js",
    "db:reset": "node --no-warnings src/db/reset.js",
    "smoke": "node --no-warnings scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "zod": "^3.23.8"
  },
  "license": "UNLICENSED",
  "private": true
}
